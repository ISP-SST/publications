#! /bin/bash 
cd 
cd /scratch/mats/doc/publications/database/
cd /home/mats/public_solar/publications/database/
#
# Bibliography web page script by Mats Löfdahl
#
yrs="2022 2021 2020"
yrs="$yrs 2019 2018 2017 2016 2015 2014 2013 2012 2011 2010"
yrs="$yrs 2009 2008 2007 2006 2005 2004 2003 2002 2001 2000"
yrs="$yrs 1999 1998 1997 1996 1995 1994 1993 1992 1991 1990"
yrs="$yrs 1989 1988 1987 1986 1985 1984 1983 1982 1981 1980"
files="unpublished $yrs 0.6m"
# Make new print-bibs.tex file
echo "----- Removing old print-bibs.tex and svst.bib"
rm -f print-bibs.tex svst.bib
#cat bib-strings.bib > svst.bib
echo "----- Make new print-bibs.tex"
(cat <<- EOF
	\\documentclass{article}
	\\usepackage{a4wide}
	\\usepackage{chapterbib}
	\\usepackage{html}
	\\usepackage{url}
	\\title{Bibliography of SST/SVST-Related Science}
	\\author{The Institute for Solar Physics}
	\\date{Printed \\today}
	\\begin{document}
	\\maketitle
EOF
) > print-bibs.tex
echo "----- Adding lines to print-bibs.tex for each individual bib file"
for yr in $files
do
  echo "------- $yr"
  if [ -s svst-$yr-ref.bib ]; then    
      echo "\\include{print-$yr-ref}" >> print-bibs.tex
  fi
  if [ -s svst-$yr-sci.bib ]; then    
      echo "\\include{print-$yr-sci}" >> print-bibs.tex
  fi
  if [ -s svst-$yr.bib ]; then
      echo "\\include{print-$yr}" >> print-bibs.tex
  fi
done
echo "----- Ending print-bibs.tex"
(cat <<- EOF
	\\end{document}
EOF
) >> print-bibs.tex
echo "----- Make new print-YYYY.tex files"
for yr in $files
do
  echo "------- $yr"
  rm -f print-$yr-ref.tex
  if [ -s svst-$yr-ref.bib ]; then    
      (cat <<- EOF
	    \\def\\refname{Refereed publications from $yr}
	    \\nocite{*}
	    \\bibliographystyle{plain}
	    \\bibliography{bib-strings,svst-$yr-ref}
	EOF
      ) > print-$yr-ref.tex
      echo  >> svst.bib
      cat svst-$yr-ref.bib >> svst.bib
      echo  >> svst.bib
  fi
  rm -f print-$yr-sci.tex
  if [ -s svst-$yr-sci.bib ]; then    
      (cat <<- EOF
	    \\def\\refname{Other scientific publications from $yr}
	    \\nocite{*}
	    \\bibliographystyle{plain}
	    \\bibliography{bib-strings,svst-$yr-sci}
	EOF
      ) > print-$yr-sci.tex
      echo  >> svst.bib
      cat svst-$yr-sci.bib >> svst.bib
      echo  >> svst.bib
  fi
  rm -f print-$yr.tex
  if [ -s svst-$yr.bib ]; then
      (cat <<- EOF
	    \\def\\refname{Other publications from $yr}
	    \\nocite{*}
	    \\bibliographystyle{plain}
	    \\bibliography{bib-strings,svst-$yr}
	EOF
      ) > print-$yr.tex
      echo  >> svst.bib
      cat svst-$yr.bib >> svst.bib
      echo  >> svst.bib
  fi
done
idl -e ".rn crossref.pro" # Make crossrefs so we can use arXiv tags as bib keys
echo "-----  Run latex on print-bibs.tex"
latex print-bibs
echo "-----  Run bibtex on the print-YYYY.bbl files"
for yr in $files
do
  echo "------- $yr"
  rm -f print-$yr-ref.blg
  if [ -s svst-$yr-ref.bib ]; then    
      bibtex print-$yr-ref
  fi
  rm -f print-$yr-sci.blg
  if [ -s svst-$yr-sci.bib ]; then    
      bibtex print-$yr-sci
  fi
  rm -f print-$yr.blg
  if [ -s svst-$yr.bib ]; then
      bibtex print-$yr
  fi
done
echo "-----  Run latex on print-bibs.tex"
latex print-bibs
echo "----- Make hardcopy"
dvips -o print-bibs.ps print-bibs
echo "----- Count references"
rm -f svst_counts svst_counts.ref svst_counts.all
echo "#Year N_ref N_sci N_other" > svst_counts
echo "#Year N_ref" > svst_counts.ref
echo "#Year N_all" > svst_counts.all
N_papers=0
for yr in $yrs
do
  echo "------- $yr"
  if [ -s svst-$yr-ref.bib ]; then    
      N_ref=`grep "bibitem" print-$yr-ref.bbl | wc -l | sed s/\ //g`
      N_papers=`echo $N_papers + $N_ref | bc`
  else
      N_ref=0
  fi
  if [ -s svst-$yr-sci.bib ]; then    
      N_sci=`grep "bibitem" print-$yr-sci.bbl | wc -l | sed s/\ //g`
      N_papers=`echo $N_papers + $N_sci | bc`
  else
      N_sci=0
  fi
  if [ -s svst-$yr.bib ]; then
      N_other=`grep "bibitem" print-$yr.bbl | wc -l | sed s/\ //g`
      N_papers=`echo $N_papers + $N_other | bc`
  else
      N_other=0
  fi
  echo $yr $N_ref $N_sci $N_other >> svst_counts
  echo $yr.15 $N_ref  >> svst_counts.ref
  echo $yr $[ N_ref + N_sci + Nother ] >> svst_counts.all
done

echo "----- Now make svst-publications.tex file"
rm -f svst-publications.tex
(cat <<- EOF
	\\documentclass{article}
	\\usepackage{html}
%	\\bodytext{bgcolor="#fafacf" text="#000000" link="#CC0000" alink="#FF3300" vlink="#330099"}
\\usepackage{color}
\\pagecolor{white}
	\\title{Bibliography of SVST and SST Related Science} 
	\\author{The Institute for Solar Physics}
	\\date{Printed \\today}
	\\def\\tmp#1{\\noindent }
	\\def\\newblock{}
	\\begin{document}
	\\maketitle

 	Here we list publications that are based on SVST/SST data,
	describe instrument development for the SVST/SST, involve data
	from the Swedish Stellar 0.6 m Telescope, or are (co-)authored
	by members of the Institute for Solar Physics staff.

	The number of publications for each year is given
	below in parentheses as a sum of the number of articles 
	published in refereed journals, the number of other scientific
	publications (e.g. proceedings papers and dissertations), and
	the number of other publications (e.g. abstracts and popular science).
	The total number of listed publications is $N_papers (results from 
	using the 0.6-m stellar telescope not counted).
	
	We want to keep this list as accurate and up to date as possible.
	If this is the first time you see this list and you know you have
	published results using data from the SST or SVST, please make sure
	your publications are listed.  Please also let us know of any new
	work.   Corrections and additions can be sent by email to
	\\htmladdnormallink{mats@astro.su.se}{mailto:mats@astro.su.se}.
		 
	Also please note that publications presenting results using data from
	the SST should have the following two sentences in the Acknowledgements 
	section:
 	\\begin{quote}
	\\emph{The Swedish 1-m Solar Telescope is operated on the island of
	La~Palma by the Institute for Solar Physics of Stockholm University in the Spanish 
	Observatorio~del Roque~de los~Muchachos of the Instituto de
	Astrofísica de Canarias. The Institute for Solar Physics is supported by a 
        grant for research infrastructures of national importance from the Swedish 
        Research Council (registration number 2017-00625).}
	\\end{quote}
	Substitute "Vacuum" for "1-m" if the data was collected with the older SVST. 
EOF
) > svst-publications.tex
echo "----- More counting"
if [ -s svst-unpublished-ref.bib ]; then    
    N_ref=`grep "bibitem" print-unpublished-ref.bbl | wc -l | sed s/\ //g`
else
      N_ref=0
fi
if [ -s svst-unpublished-sci.bib ]; then    
    N_sci=`grep "bibitem" print-unpublished-sci.bbl | wc -l | sed s/\ //g`
else
    N_sci=0
fi
if [ -s svst-unpublished.bib ]; then
    N_other=`grep "bibitem" print-unpublished.bbl | wc -l | sed s/\ //g`
else
    N_other=0
fi
N_papers=`echo $N_ref + $N_sci + $N_other | bc`
echo "----- "
if [ $N_papers -gt 0 ]; then
    echo "\\section{Not yet published ($N_ref+$N_sci+$N_other=$N_papers)}" >> svst-publications.tex
    echo "\\subsection{Articles in refereed journals ($N_ref)}" >> svst-publications.tex
    if [ -s svst-unpublished-ref.bib ]; then
	tmp=`tail -n +2 print-unpublished-ref.bbl | wc -l | sed s/\ //g`
	head -n $tmp print-unpublished-ref.bbl | tail -n +2 | sed s/\\\\newblock//g | sed "s/\\\\bibitem/\\\\tmp/g"  >> svst-publications.tex
    fi
    echo "\\subsection{Other scientific publications ($N_sci)}" >> svst-publications.tex
    if [ -s svst-unpublished-sci.bib ]; then
	tmp=`tail -n +2 print-unpublished-sci.bbl | wc -l | sed s/\ //g`
	head -n $tmp print-unpublished-sci.bbl | tail -n +2 | sed s/\\\\newblock//g | sed "s/\\\\bibitem/\\\\tmp/g"  >> svst-publications.tex
    fi
    echo "\\subsection{Other publications ($N_other)}" >> svst-publications.tex
    if [ -s svst-unpublished.bib ]; then
	tmp=`tail -n +2 print-unpublished.bbl | wc -l | sed s/\ //g`
	head -n $tmp print-unpublished.bbl | tail -n +2 | sed s/\\\\newblock//g | sed "s/\\\\bibitem/\\\\tmp/g"  >> svst-publications.tex
    fi
    #if [ -s svst-unpublished.bib ]; then
    #    tmp=`tail +2 print-unpublished.bbl | wc -l | sed s/\ //g`
    #    head -$tmp print-unpublished.bbl | tail +2 | sed s/\\\\newblock//g | sed "s/\\\\bibitem/\\\\tmp/g"  >> svst-publications.tex
    #fi
fi
echo "----- Add lines to svst-publications.tex"
for yr in $yrs
do
  echo "------- $yr"
  if [ -s svst-$yr-ref.bib ]; then    
      N_ref=`grep "bibitem" print-$yr-ref.bbl | wc -l | sed s/\ //g`
  else
      N_ref=0
  fi
  if [ -s svst-$yr-sci.bib ]; then    
      N_sci=`grep "bibitem" print-$yr-sci.bbl | wc -l | sed s/\ //g`
  else
      N_sci=0
  fi
  if [ -s svst-$yr.bib ]; then
      N_other=`grep "bibitem" print-$yr.bbl | wc -l | sed s/\ //g`
  else
      N_other=0
  fi
  N_papers=`echo $N_ref + $N_sci + $N_other | bc`
  if [ $N_papers -gt 0 ]; then
      echo "\\section{Publications from $yr ($N_ref+$N_sci+$N_other=$N_papers)}" >> svst-publications.tex
      echo "\\subsection{Articles in refereed journals ($N_ref)}" >> svst-publications.tex
      if [ -s svst-$yr-ref.bib ]; then
	  tmp=`tail -n +2 print-$yr-ref.bbl | wc -l | sed s/\ //g`
	  head -n $tmp print-$yr-ref.bbl | tail -n +2 | sed s/\\\\newblock//g | sed "s/\\\\bibitem/\\\\tmp/g"  >> svst-publications.tex
      fi
      echo "\\subsection{Other scientific publications ($N_sci)}" >> svst-publications.tex
      if [ -s svst-$yr-sci.bib ]; then
	  tmp=`tail -n +2 print-$yr-sci.bbl | wc -l | sed s/\ //g`
	  head -n $tmp print-$yr-sci.bbl | tail -n +2 | sed s/\\\\newblock//g | sed "s/\\\\bibitem/\\\\tmp/g"  >> svst-publications.tex
      fi
      echo "\\subsection{Other publications ($N_other)}" >> svst-publications.tex
      if [ -s svst-$yr.bib ]; then
	  tmp=`tail -n +2 print-$yr.bbl | wc -l | sed s/\ //g`
	  head -n $tmp print-$yr.bbl | tail -n +2 | sed s/\\\\newblock//g | sed "s/\\\\bibitem/\\\\tmp/g"  >> svst-publications.tex
      fi
  fi
done
echo "----- Even more counting"
if [ -s svst-0.6m-ref.bib ]; then    
    N_ref=`grep "bibitem" print-0.6m-ref.bbl | wc -l | sed s/\ //g`
else
    N_ref=0
fi
if [ -s svst-0.6m-sci.bib ]; then    
    N_sci=`grep "bibitem" print-0.6m-sci.bbl | wc -l | sed s/\ //g`
else
    N_sci=0
fi
if [ -s svst-0.6m.bib ]; then
    N_other=`grep "bibitem" print-0.6m.bbl | wc -l | sed s/\ //g`
else
    N_other=0
fi
N_papers=`echo $N_ref + $ N_sci + $N_other | bc`
echo "----- Add more lines"
if [ $N_papers -gt 0 ]; then
    echo "\\section{Publications using the 0.6 m stellar telescope ($N_ref+$N_other=$N_papers)}" >> svst-publications.tex
    echo "\\subsection{Articles in refereed journals ($N_ref)}" >> svst-publications.tex
    if [ -s svst-0.6m-ref.bib ]; then
        tmp=`tail -n +2 print-0.6m-ref.bbl | wc -l | sed s/\ //g`
        head -n $tmp print-0.6m-ref.bbl | tail -n +2 | sed s/\\\\newblock//g | sed "s/\\\\bibitem/\\\\tmp/g"  >> svst-publications.tex
    fi
    echo "\\subsection{Other scientific publications ($N_sci)}" >> svst-publications.tex
    if [ -s svst-0.6m-sci.bib ]; then
        tmp=`tail -n +2 print-0.6m-sci.bbl | wc -l | sed s/\ //g`
        head -n $tmp print-0.6m-sci.bbl | tail -n +2 | sed s/\\\\newblock//g | sed "s/\\\\bibitem/\\\\tmp/g"  >> svst-publications.tex
    fi
    echo "\\subsection{Other publications ($N_other)}" >> svst-publications.tex
    if [ -s svst-0.6m.bib ]; then
        tmp=`tail -n +2 print-0.6m.bbl | wc -l | sed s/\ //g`
        head -n $tmp print-0.6m.bbl | tail -n +2 | sed s/\\\\newblock//g | sed "s/\\\\bibitem/\\\\tmp/g"  >> svst-publications.tex
    fi
fi
echo "----- Behind the scenes section"
(cat <<- EOF
	\\section{Behind the scenes ...}

	\\subsection{Shell script}

	A \\htmladdnormallink{shell script}{DoIt} makes html files
	from the bibliography database files.  It outputs latex files
	that \verb+\\nocite{*}+ all items in whatever bibtex files
	exists at run-time.  It runs latex and bibtex and then
	re-arranges the resulting files into yet another latex file
	that works with latex2html.  In the process we also get a
	PostScript file to make hard copies.

	\\subsection{Bibtex database files}

	The \\htmladdnormallink{bibtex database files}{svst.bib} use some
	\\htmladdnormallink{string definitions}{bib-strings.bib}.
%	\\begin{itemize}
EOF
) >> svst-publications.tex

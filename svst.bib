  title	       = "Solar Magnetoconvection and Small-Scale Dynamo",
  journal      = "Space Science Reviews",
  year	       = 2017,
  month	       = "Sep",
  day	       = 01,
  volume       = 210,
  number       = 1,
  pages	       = "275-316",
  abstract     = "A number of observational and theoretical aspects of
                  solar magnetoconvection are considered in this
                  review. We discuss recent developments in our
                  understanding of the small-scale structure of the
                  magnetic field on the solar surface and its
                  interaction with convective flows, which is at the
                  centre of current research. Topics range from plage
                  areas in active regions over the magnetic network
                  shaped by supergranulation to the ubiquituous
                  `turbulent' internetwork fields. On the theoretical
                  side, we focus upon magnetic field generation by
                  small-scale dynamo action.",
  issn	       = "1572-9672",
  doi	       = "10.1007/s11214-015-0204-5"
}

